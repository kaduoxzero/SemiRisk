# SemiRisk 环境变量模板
# 复制为 .env 文件并填入实际值，切勿提交到版本控制

# ── 应用端口 ──────────────────────────────────────
SEMIRISK_PORT=8080

# ── 中间件主机（所有中间件所在机器 IP 或 Docker 网络名） ──
SEMIRISK_MIDDLEWARE_HOST=

# ── 数据库 ──────────────────────────────────────
SEMIRISK_DB_URL=jdbc:mysql://${SEMIRISK_MIDDLEWARE_HOST}:3306/semirisk?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
SEMIRISK_DB_USERNAME=semirisk
SEMIRISK_DB_PASSWORD=

# ── Redis Cluster ──────────────────────────────────────
# 格式: ip1:port1,ip2:port2,...
SEMIRISK_REDIS_NODES=
SEMIRISK_REDIS_PASSWORD=

# ── Elasticsearch ──────────────────────────────────────
SEMIRISK_ES_URL=http://${SEMIRISK_MIDDLEWARE_HOST}:9200
SEMIRISK_ES_INDEX=semirisk_knowledge

# ── MinIO ──────────────────────────────────────
SEMIRISK_MINIO_ENDPOINT=http://${SEMIRISK_MIDDLEWARE_HOST}:9000
SEMIRISK_MINIO_PORT=9000
SEMIRISK_MINIO_ACCESS_KEY=
SEMIRISK_MINIO_SECRET_KEY=

# ── RabbitMQ ──────────────────────────────────────
SEMIRISK_RABBITMQ_PORT=5672
SEMIRISK_RABBITMQ_USER=
SEMIRISK_RABBITMQ_PASS=
SEMIRISK_RABBITMQ_HTTP_PORT=15672

# ── Nacos ──────────────────────────────────────
SEMIRISK_NACOS_HOST=
SEMIRISK_NACOS_PORT=8848
SEMIRISK_NACOS_NAMESPACE=public
SEMIRISK_NACOS_GROUP=SEMIRISK

# ── AI 模型 ──────────────────────────────────────
SEMIRISK_AI_MODEL=deepseekv4-pro
SEMIRISK_AI_ENDPOINT=https://api.deepseek.com/v1
SEMIRISK_AI_API_KEY=

# ── 引导管理员（首次启动创建，留空则不创建） ──
SEMIRISK_BOOTSTRAP_ADMIN_ENABLED=true
SEMIRISK_BOOTSTRAP_ADMIN_USERNAME=
SEMIRISK_BOOTSTRAP_ADMIN_PASSWORD=
SEMIRISK_BOOTSTRAP_ADMIN_DISPLAY_NAME=
SEMIRISK_BOOTSTRAP_ADMIN_EMAIL=

# ── 邮件服务 ──────────────────────────────────────
SEMIRISK_MAIL_USERNAME=
SEMIRISK_MAIL_APP_PASSWORD=
SEMIRISK_MAIL_FROM=

# ── 数据服务 URL（Docker 环境中应为服务名） ──
SEMIRISK_DATA_SERVICE_URL=http://semirisk-data-service:8081

# ── Sentinel ──────────────────────────────────────
SEMIRISK_SENTINEL_DASHBOARD=

# ── Flyway ──────────────────────────────────────
SEMIRISK_FLYWAY_ENABLED=false

# ── 健康检查 ──────────────────────────────────────
SEMIRISK_HEALTH_DB_ENABLED=false
SEMIRISK_HEALTH_REDIS_ENABLED=false

# ── Embedding / Vector（可选） ──────────────────────────────────────
SEMIRISK_EMBEDDING_ENDPOINT=
SEMIRISK_EMBEDDING_API_KEY=

# ── Docker Compose 中间件密码 ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MINIO_ROOT_PASSWORD=
MINIO_ROOT_USER=
RABBITMQ_DEFAULT_PASS=
REDIS_CLUSTER_PASSWORD=
